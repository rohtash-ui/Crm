      "code": {
        "$value": { "fontFamily": "{typography.fontFamily.mono}", "fontSize": "{typography.fontSize.md}", "fontWeight": "{typography.fontWeight.regular}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      }
    }
  },

  "spacing": {
