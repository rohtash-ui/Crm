          "brand":        { "$value": "{color.primitive.blue.600}",  "$type": "color", "$description": "Brand-colored text/icon" },
          "success":      { "$value": "{color.primitive.green.700}", "$type": "color", "$description": "Success text" },
          "warning":      { "$value": "{color.primitive.amber.700}", "$type": "color", "$description": "Warning text" },
          "danger":       { "$value": "{color.primitive.red.600}",   "$type": "color", "$description": "Danger/error text" },
          "info":         { "$value": "{color.primitive.blue.700}",  "$type": "color", "$description": "Informational text" }
