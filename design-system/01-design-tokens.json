          "overlay":      { "$value": "{color.primitive.alpha.black-40}", "$type": "color", "$description": "Modal/dialog backdrop" },
          "brand":        { "$value": "{color.primitive.blue.600}",  "$type": "color", "$description": "Primary brand surface" },
          "brandSubtle":  { "$value": "{color.primitive.blue.50}",   "$type": "color", "$description": "Subtle brand tint" },
          "success":      { "$value": "{color.primitive.green.50}",  "$type": "color", "$description": "Success state background" },
