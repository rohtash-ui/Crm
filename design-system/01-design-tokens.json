  "typography": {
    "$description": "Type scale, weights, and line heights. Based on Inter font family.",

    "fontFamily": {
      "sans":  { "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "mono":  { "$value": "'JetBrains Mono', 'SF Mono', 'Fira Code', 'Cascadia Code', monospace", "$type": "fontFamily" }
    },

    "fontSize": {
      "xs":     { "$value": "0.6875rem", "$type": "dimension", "$description": "11px — Micro labels, badges" },
      "sm":     { "$value": "0.75rem",   "$type": "dimension", "$description": "12px — Captions, helper text" },
      "md":     { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — Table cells, compact UI" },
      "base":   { "$value": "0.875rem",  "$type": "dimension", "$description": "14px — Body text, form inputs" },
      "lg":     { "$value": "1rem",      "$type": "dimension", "$description": "16px — Section headers, emphasized body" },
      "xl":     { "$value": "1.125rem",  "$type": "dimension", "$description": "18px — Card titles, sub-headings" },
      "2xl":    { "$value": "1.25rem",   "$type": "dimension", "$description": "20px — Page section headers" },
      "3xl":    { "$value": "1.5rem",    "$type": "dimension", "$description": "24px — Page titles" },
      "4xl":    { "$value": "1.875rem",  "$type": "dimension", "$description": "30px — Display/hero text" }
    },

    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },

    "lineHeight": {
      "tight":    { "$value": 1.2,  "$type": "number", "$description": "Headings" },
      "snug":     { "$value": 1.35, "$type": "number", "$description": "Subheadings, compact text" },
      "normal":   { "$value": 1.5,  "$type": "number", "$description": "Body text" },
      "relaxed":  { "$value": 1.625,"$type": "number", "$description": "Long-form reading" }
    },

    "letterSpacing": {
      "tight":    { "$value": "-0.01em", "$type": "dimension", "$description": "Display text" },
      "normal":   { "$value": "0em",     "$type": "dimension", "$description": "Body text" },
      "wide":     { "$value": "0.025em", "$type": "dimension", "$description": "Uppercase labels, overlines" }
    },

    "composite": {
      "$description": "Pre-composed type styles for direct use.",
      "display": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.4xl}", "fontWeight": "{typography.fontWeight.bold}", "lineHeight": "{typography.lineHeight.tight}", "letterSpacing": "{typography.letterSpacing.tight}" },
        "$type": "typography"
      },
      "heading1": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.3xl}", "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.tight}", "letterSpacing": "{typography.letterSpacing.tight}" },
        "$type": "typography"
      },
      "heading2": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.2xl}", "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.tight}", "letterSpacing": "{typography.letterSpacing.tight}" },
        "$type": "typography"
      },
      "heading3": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.xl}", "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.snug}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "heading4": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.lg}", "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.snug}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "bodyLg": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.lg}", "fontWeight": "{typography.fontWeight.regular}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "body": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.base}", "fontWeight": "{typography.fontWeight.regular}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "bodySm": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.md}", "fontWeight": "{typography.fontWeight.regular}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "caption": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.sm}", "fontWeight": "{typography.fontWeight.regular}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.normal}" },
        "$type": "typography"
      },
      "micro": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.xs}", "fontWeight": "{typography.fontWeight.medium}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.wide}" },
        "$type": "typography"
      },
      "overline": {
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "{typography.fontSize.xs}", "fontWeight": "{typography.fontWeight.semibold}", "lineHeight": "{typography.lineHeight.normal}", "letterSpacing": "{typography.letterSpacing.wide}" },
        "$type": "typography",
        "$description": "Always uppercase. Used for section labels and category tags."
