    "alias": {
      "$description": "Named spacing tokens for common use cases.",
      "insetXs":     { "$value": "{spacing.1}",   "$type": "dimension", "$description": "4px — Tiny internal padding (badges, chips)" },
      "insetSm":     { "$value": "{spacing.2}",   "$type": "dimension", "$description": "8px — Compact internal padding" },
      "insetMd":     { "$value": "{spacing.3}",   "$type": "dimension", "$description": "12px — Default internal padding (buttons, inputs)" },
      "insetLg":     { "$value": "{spacing.4}",   "$type": "dimension", "$description": "16px — Generous internal padding (cards)" },
      "insetXl":     { "$value": "{spacing.6}",   "$type": "dimension", "$description": "24px — Section-level padding" },
      "stackXs":     { "$value": "{spacing.1}",   "$type": "dimension", "$description": "4px — Tight vertical gap" },
      "stackSm":     { "$value": "{spacing.2}",   "$type": "dimension", "$description": "8px — Default vertical gap between related items" },
      "stackMd":     { "$value": "{spacing.4}",   "$type": "dimension", "$description": "16px — Gap between groups" },
      "stackLg":     { "$value": "{spacing.6}",   "$type": "dimension", "$description": "24px — Gap between sections" },
      "stackXl":     { "$value": "{spacing.10}",  "$type": "dimension", "$description": "40px — Major section separation" },
      "inlineXs":    { "$value": "{spacing.1}",   "$type": "dimension", "$description": "4px — Icon-to-text gap" },
      "inlineSm":    { "$value": "{spacing.2}",   "$type": "dimension", "$description": "8px — Default inline gap" },
