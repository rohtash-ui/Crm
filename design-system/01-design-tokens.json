      "$description": "Low elevation — hovered cards"
    },
    "md":     {
      "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
      "$type": "shadow",
      "$description": "Medium elevation — dropdowns, popovers"
