{
  "name": "@crm/whatsapp-notifications",
  "version": "1.0.0",
  "description": "WhatsApp notification service for CRM lead lifecycle events",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/ --ext .ts",
    "migrate": "node-pg-migrate up"
  },
  "dependencies": {
    "@crm/authz": "workspace:*",
    "@crm/obs": "workspace:*",
    "@crm/idempotency": "workspace:*",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "axios": "^1.6.2",
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "pino": "^8.17.1",
    "pino-http": "^9.0.0",
    "node-cron": "^3.0.3",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "eslint": "^8.55.0"
  }
}
