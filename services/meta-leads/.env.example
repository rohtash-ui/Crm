# Meta App Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v18.0
META_WEBHOOK_VERIFY_TOKEN=a_random_string_for_webhook_verification

# Database
DATABASE_URL=postgres://user:password@localhost:5432/crm_meta_leads?sslmode=disable

# Kafka
KAFKA_BROKERS=localhost:9092

# Encryption
KMS_KEY_ID=default-dev-key

# Polling Configuration
POLL_INTERVAL_SECONDS=300
POLL_SAFETY_OVERLAP_SECONDS=600

# Server
HTTP_PORT=8080
