# CRM Sync Service Configuration
# Copy this to .env and fill in your actual values

# --- Database ---
DATABASE_URL=postgres://crm_user:password@localhost:5432/crm?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Legacy CRM (nfs.mecntech.com) ---
NFS_CRM_BASE_URL=https://nfs.mecntech.com
NFS_CRM_API_KEY=your-api-key-here
# OR use basic auth instead of API key:
# NFS_CRM_USERNAME=your-username
# NFS_CRM_PASSWORD=your-password

# --- Sync settings ---
TENANT_ID=default
SYNC_PORT=8080
SYNC_INTERVAL_MIN=30
